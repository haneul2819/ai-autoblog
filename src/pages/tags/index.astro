---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, groupByTag } from '../../lib/posts';
import { href } from '../../lib/url';

const posts = await getPublishedPosts();
const tags = groupByTag(posts);
---

<BaseLayout title="태그" description="주제별로 묶어 본 글 목록입니다.">
  <div class="page-intro">
    <h1>태그</h1>
    <p>글 {posts.length}편에 붙은 태그 {tags.length}개입니다. 자주 나온 순서로 놓았습니다.</p>
  </div>

  {
    tags.length === 0 ? (
      <p class="empty-state">아직 태그가 없습니다.</p>
    ) : (
      <ul class="tag-cloud">
        {tags.map(({ tag, posts: tagged }) => (
          <li>
            <a class="tag-chip" href={href(`/tags/${encodeURIComponent(tag)}/`)}>
              {tag}
              <span class="count">{tagged.length}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

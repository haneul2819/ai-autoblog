---
import { SITE_TITLE, SITE_DESCRIPTION, NAV } from '../consts';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 글 상세에서만 채운다. Open Graph 타입과 정규 URL 계산에 쓴다. */
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = 'website',
  publishedTime,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="ko_KR" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131413" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      // 첫 페인트 전에 테마를 확정해 깜빡임을 막는다.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>

  <body>
    <div class="shell">
      <a class="skip-link" href="#content">본문으로 건너뛰기</a>

      <header class="site-header">
        <div class="wrap site-header__inner">
          <a class="site-header__brand" href="/">{SITE_TITLE}</a>
          <nav class="site-nav" aria-label="주요 메뉴">
            {
              NAV.map((item) => (
                <a
                  href={item.href}
                  aria-current={
                    (item.href === '/' ? pathname === '/' : pathname.startsWith(item.href))
                      ? 'page'
                      : undefined
                  }
                >
                  {item.label}
                </a>
              ))
            }
            <ThemeToggle />
          </nav>
        </div>
      </header>

      <main id="content">
        <div class="wrap">
          <slot />
        </div>
      </main>

      <footer class="site-footer">
        <div class="wrap">
          <p>{SITE_TITLE} — 하루 세 번, 사람이 고르지 않고 자동으로 발행됩니다.</p>
          <p>
            <a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">사이트맵</a> ·
            <a href="/about">이 사이트에 대하여</a>
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
